{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Squoosh Tool",
  "mainBinaryName": "squoosh-tool",
  "version": "2.0.2",
  "identifier": "app.squoosh.desktop",
  "build": {
    "frontendDist": "../build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "languages": ["SimpChinese"],
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}
